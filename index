function fmtLine(text) {
  var parts = [];
  var k = 0;

  // Önce $..$ ve $$...$$ ifadelerini işle
  var segments = [];
  var rem = text;
  var mathReg = /(\$\$[\s\S]+?\$\$|\$[^$\n]+?\$)/g;
  var lastIdx = 0;
  var m;
  while ((m = mathReg.exec(text)) !== null) {
    if (m.index > lastIdx) segments.push({type:"text", val: text.slice(lastIdx, m.index)});
    var isDisplay = m[1].startsWith("$$");
    var expr = isDisplay ? m[1].slice(2,-2) : m[1].slice(1,-1);
    segments.push({type:"math", val: expr, display: isDisplay});
    lastIdx = m.index + m[1].length;
  }
  if (lastIdx < text.length) segments.push({type:"text", val: text.slice(lastIdx)});

  segments.forEach(function(seg) {
    if (seg.type === "math") {
      parts.push(renderMath(seg.val, seg.display));
      return;
    }
    // Normal metin — önce ham LaTeX'i temizle ($ olmadan yazılmış)
    var cleaned = seg.val
      // \int_{a}^{b} → ∫ₐᵇ
      .replace(/\\int_?\{?([^}^]*)\}?\^?\{?([^}]*)\}?/g, function(_, from, to) {
        return '∫' + (from?'('+from.replace(/[{}]/g,'')+')':'') + (to?'→('+to.replace(/[{}]/g,'')+')'  :'');
      })
      .replace(/\\int\b/g, '∫')
      .replace(/\\left\[/g, '[').replace(/\\right\]/g, ']')
      .replace(/\\left\(/g, '(').replace(/\\right\)/g, ')')
      .replace(/\\left\{/g, '{').replace(/\\right\}/g, '}')
      .replace(/\\left\|/g, '|').replace(/\\right\|/g, '|')
      .replace(/\\cdot/g, '·').replace(/\\times/g, '×')
      .replace(/\\leq/g, '≤').replace(/\\geq/g, '≥').replace(/\\neq/g, '≠')
      .replace(/\\approx/g, '≈').replace(/\\pm/g, '±')
      .replace(/\\infty/g, '∞').replace(/\\circ/g, '°')
      .replace(/\\pi/g, 'π').replace(/\\alpha/g, 'α').replace(/\\beta/g, 'β')
      .replace(/\\theta/g, 'θ').replace(/\\delta/g, 'δ').replace(/\\Delta/g, 'Δ')
      .replace(/\\sin/g, 'sin').replace(/\\cos/g, 'cos').replace(/\\tan/g, 'tan')
      .replace(/\\ln/g, 'ln').replace(/\\log/g, 'log')
      .replace(/\\sqrt\{([^}]+)\}/g, '√($1)').replace(/\\sqrt/g, '√')
      .replace(/\\_/g, '').replace(/\\\\/g, ' ')
      .replace(/₍/g, '(').replace(/₎/g, ')'); // alt indis parantezleri

    // Şimdi bold ve code işle
    var r = cleaned;
    while (r.length > 0) {
      var bm = r.match(/\*\*(.*?)\*\*/);
      var cm = r.match(/`(.*?)`/);
      var candidates = [bm, cm].filter(Boolean);
      if (candidates.length === 0) { parts.push(React.createElement('span', { key: k++,}, r)); break; }
      var first = candidates.sort(function(a,b){ return a.index-b.index; })[0];
      if (first.index > 0) parts.push(React.createElement('span', { key: k++,}, r.slice(0, first.index)));
      if (first === bm) parts.push(React.createElement('strong', { key: k++, style: {fontWeight:800},}, first[1]));
      else parts.push(React.createElement('code', { key: k++, style: {background:"rgba(79,70,229,0.2)",padding:"1px 5px",borderRadius:3,fontSize:12,fontFamily:"monospace",color:"#c3c0ff"},}, first[1]));
      r = r.slice(first.index + first[0].length);
    }
  });
  return parts;
}

function Md({ text }) {
  // $$...$$ bloklarını önceden ayır
  var blocks = [];
  var rem = (text||"");
  var dblReg = /\$\$([\s\S]+?)\$\$/g;
  var last = 0; var dm;
  while ((dm = dblReg.exec(rem)) !== null) {
    if (dm.index > last) blocks.push({type:"text", val: rem.slice(last, dm.index)});
