function lsSet2(k,v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch(e) {} }

function TechAI({prog, setProg, dens, user, fbUser, saveToCloud, T, darkMode}) {
  var DT = {
    bg:"#0b1326", card:"rgba(45,52,73,0.6)", border:"rgba(70,69,85,0.2)",
