function renderFrac(num, den) {
  return (
    React.createElement('span', { style: {display:"inline-flex",flexDirection:"column",alignItems:"center",
      verticalAlign:"middle",margin:"0 2px",lineHeight:1.1},}
      , React.createElement('span', { style: {borderBottom:"1.5px solid #c3c0ff",paddingBottom:1,fontSize:"0.85em"},}, num)
      , React.createElement('span', { style: {paddingTop:1,fontSize:"0.85em"},}, den)
    )
  );
}

function renderMathExpr(expr) {
  // Önce iç içe frac'ları çöz
  var parts = [];
  var rem = expr.trim();

  // \frac{a}{b} → gerçek kesir
  var fracReg = /\\frac\{([^{}]*(?:\{[^{}]*\}[^{}]*)*)\}\{([^{}]*(?:\{[^{}]*\}[^{}]*)*)\}/g;
  var lastI = 0; var fm;
  var segments2 = [];
  while ((fm = fracReg.exec(rem)) !== null) {
    if (fm.index > lastI) segments2.push({type:"text", val: rem.slice(lastI, fm.index)});
    segments2.push({type:"frac", num: fm[1], den: fm[2]});
    lastI = fm.index + fm[0].length;
  }
  if (lastI < rem.length) segments2.push({type:"text", val: rem.slice(lastI)});

  return segments2.map(function(seg, si) {
    if (seg.type === "frac") {
      return React.createElement('span', { key: si,}, renderFrac(cleanSymbols(seg.num), cleanSymbols(seg.den)));
    }
    return React.createElement('span', { key: si,}, cleanSymbols(seg.val));
  });
}

function cleanSymbols(s) {
  return s
    .replace(/\\int\b/g, '∫').replace(/\\iint\b/g, '∬').replace(/\\oint\b/g, '∮')
    .replace(/\\sum\b/g, 'Σ').replace(/\\prod\b/g, 'Π').replace(/\\lim\b/g, 'lim')
    .replace(/\\sqrt\{([^}]+)\}/g, '√($1)').replace(/\\sqrt\b/g, '√')
    .replace(/\\cos\b/g, 'cos').replace(/\\sin\b/g, 'sin').replace(/\\tan\b/g, 'tan')
    .replace(/\\cot\b/g, 'cot').replace(/\\sec\b/g, 'sec').replace(/\\csc\b/g, 'csc')
    .replace(/\\log\b/g, 'log').replace(/\\ln\b/g, 'ln').replace(/\\exp\b/g, 'exp')
    .replace(/\\cdot\b/g, '·').replace(/\\times\b/g, '×').replace(/\\div\b/g, '÷')
    .replace(/\\pi\b/g, 'π').replace(/\\alpha\b/g, 'α').replace(/\\beta\b/g, 'β')
    .replace(/\\gamma\b/g, 'γ').replace(/\\delta\b/g, 'δ').replace(/\\Delta\b/g, 'Δ')
    .replace(/\\theta\b/g, 'θ').replace(/\\lambda\b/g, 'λ').replace(/\\mu\b/g, 'μ')
    .replace(/\\sigma\b/g, 'σ').replace(/\\Sigma\b/g, 'Σ').replace(/\\omega\b/g, 'ω')
    .replace(/\\infty\b/g, '∞').replace(/\\circ\b/g, '°').replace(/\\degree\b/g, '°')
    .replace(/\\leq\b/g, '≤').replace(/\\geq\b/g, '≥').replace(/\\neq\b/g, '≠')
    .replace(/\\approx\b/g, '≈').replace(/\\pm\b/g, '±').replace(/\\mp\b/g, '∓')
    .replace(/\\rightarrow\b/g, '→').replace(/\\leftarrow\b/g, '←').replace(/\\Rightarrow\b/g, '⇒')
    .replace(/\\in\b/g, '∈').replace(/\\notin\b/g, '∉').replace(/\\subset\b/g, '⊂')
    .replace(/\\cup\b/g, '∪').replace(/\\cap\b/g, '∩').replace(/\\emptyset\b/g, '∅')
    .replace(/\\widehat\{([^}]*)\}/g, '$1̂').replace(/\\overline\{([^}]*)\}/g, '$1̄')
    .replace(/\\hat\{([^}]*)\}/g, '$1̂').replace(/\\vec\{([^}]*)\}/g, '$1⃗')
    .replace(/\^2/g, '²').replace(/\^3/g, '³').replace(/\^{([^}]+)}/g, '^($1)')
    .replace(/\_\{([^}]+)\}/g, '₍$1₎').replace(/\{|\}/g, '')
