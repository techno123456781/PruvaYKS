function getBrans(n) {
  n = n.toLowerCase();
  if (n.includes("türkçe")||n.includes("paragraf")||n.includes("edebiyat")||n.includes("divan")||n.includes("tanzimat")) return "DIL";
  if (n.includes("matematik")||n.includes("fonksiyon")||n.includes("logaritma")||n.includes("türev")||n.includes("integral")||n.includes("trigono")||n.includes("limit")) return "MAT";
  if (n.includes("geometri")||n.includes("üçgen")||n.includes("çember")||n.includes("uzay")) return "GEO";
  if (n.includes("fizik")||n.includes("hareket")||n.includes("kuvvet")||n.includes("enerji")||n.includes("newton")) return "FIZ";
  if (n.includes("kimya")||n.includes("atom")||n.includes("gaz")||n.includes("organik")||n.includes("asit")) return "KIM";
  if (n.includes("biyoloji")||n.includes("hücre")||n.includes("sinir")||n.includes("fotosentez")||n.includes("evrim")) return "BIO";
  if (n.includes("tarih")||n.includes("osmanlı")||n.includes("inkılap")) return "TAR";
  if (n.includes("coğrafya")||n.includes("iklim")||n.includes("nüfus")) return "COG";
  return "DIG";
}

function makePlan(selTopics, dateStr) {
  const today = new Date(); today.setHours(0,0,0,0);
  const target = new Date(dateStr);
  const totalDays = Math.ceil((target - today) / 86400000);
  if (totalDays < 2) return null;
  const slots = [];
  selTopics.forEach(t => {
    const b = getBrans(t.name);
    for (let s = 1; s <= t.duration; s++) slots.push({name:t.name, step:s, total:t.duration, brans:b});
  });
  const sunIdx = new Set(), workIdx = [];
  for (let i = 0; i < totalDays; i++) {
    const d = new Date(today); d.setDate(today.getDate()+i);
    if (d.getDay() === 0) sunIdx.add(i); else workIdx.push(i);
  }
  const ppd = Math.max(2, Math.min(workIdx.length > 0 ? Math.ceil(slots.length/workIdx.length) : 3, 9));
  const grps = {};
  slots.forEach(s => { if (!grps[s.brans]) grps[s.brans] = []; grps[s.brans].push(s); });
  const qs = Object.values(grps).sort((a,b) => b.length-a.length);
  const interleaved = [];
  let safety = slots.length * 2;
  while (interleaved.length < slots.length && safety-- > 0) {
    for (const q of qs) { if (q.length > 0 && interleaved.length < slots.length) interleaved.push(q.shift()); }
  }
  const daySlots = {}; let si = 0;
  for (const wi of workIdx) {
    daySlots[wi] = [];
    for (let c = 0; c < ppd && si < interleaved.length; c++, si++) daySlots[wi].push(interleaved[si]);
  }
  const rutins = [
    {i:"20-30 Paragraf Sorusu",n:"Okuduğunu anlama & hız"},
    {i:"15-20 Matematik Sorusu",n:"Analitik düşünce pratiği"},
    {i:"15 Sözel Muhakeme",n:"Anlam & çıkarım odaklı"},
    {i:"Geometri Alıştırma",n:"Şekil ve formül pratiği"},
  ];
  const tekrars = [
    {i:"🔁 TYT Paragraf Tekrarı",n:"20 soru hızlı tara"},
    {i:"🔁 Formüller Tekrarı",n:"Tüm formülleri gözden geçir"},
    {i:"🔁 Zayıf Konu Tekrarı",n:"Yanlış yaptıklarını çöz"},
  ];
  let wc = 0, wk = 0, ti = 0;
  const plan = [];
  for (let i = 0; i < totalDays; i++) {
    const d = new Date(today); d.setDate(today.getDate()+i);
    const tasks = [];
    const isSun = sunIdx.has(i), isL10 = i >= totalDays - 10;
    if (isSun) {
      wk++;
      const tp = wk % 2 === 0 ? "TYT" : "AYT";
      tasks.push({i:`📝 Haftalık Deneme (${tp})`, t:"deneme", n:"Tam zamanlı — süreye uy", done:false});
      tasks.push({i:"📋 Yanlış Analizi", t:"tekrar", n:"Her yanlışın kaynağını bul", done:false});
    } else {
      tasks.push({i:rutins[wc%rutins.length].i, t:"rutin", n:rutins[wc%rutins.length].n, done:false});
      (daySlots[i]||[]).forEach(sl => {
        tasks.push({i:`${sl.name} (${sl.step}/${sl.total})`, t:"ana",
          n: sl.step <= Math.ceil(sl.total/2) ? "📖 Konu Anlatım + Temel Test" : "🔥 İleri Soru Çözümü", done:false});
      });
      if (isL10) { tasks.push({i:"⚡ Son Tekrar Paketi", t:"deneme", n:"Tüm notlarını gözden geçir", done:false}); }
      else if (i >= Math.floor(totalDays*0.8) && wc%3===0) {
        const tk = tekrars[ti%tekrars.length]; ti++;
        tasks.push({i:tk.i, t:"tekrar", n:tk.n, done:false});
      }
      wc++;
    }
    plan.push({
      tarih: d.toLocaleDateString("tr-TR",{day:"numeric",month:"long",weekday:"short"}),
      tasks, special: isSun||isL10, moral: MORALLER[i%MORALLER.length]
    });
  }
  return plan;
}

