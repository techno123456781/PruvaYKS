  function handleImageSelect(e) {
    var file = e.target.files && e.target.files[0];
    if (!file) return;
    var reader = new FileReader();
    reader.onload = function(ev) {
      var base64 = ev.target.result.split(",")[1];
      setImage({base64: base64, type: file.type});
      setImagePreview(ev.target.result);
    };
    reader.readAsDataURL(file);
  }

  function buildCtx() {
    var p = progRef.current; var d = densRef.current;
    var progTxt = "";
    if (!p) { progTxt = "Henuz aktif program yok."; }
    else {
      var cd = Math.max(0, Math.ceil((new Date(p.targetDate)-new Date())/86400000));
      var tot = 0, don = 0;
      p.plan.forEach(function(day) { day.tasks.forEach(function(t) { tot++; if(t.done) don++; }); });
      var today = new Date(); today.setHours(0,0,0,0);
      var lines = [];
      p.plan.forEach(function(day, di) {
        var dd = new Date(today); dd.setDate(today.getDate()+di);
        var rel = dd < today ? "[GECTI]" : dd.getTime()===today.getTime() ? "[BUGUN]" : "[gelecek]";
        day.tasks.slice(0,3).forEach(function(t) { lines.push(rel+" Gun"+(di+1)+": "+t.i+" ("+(t.done?"yapildi":"bekliyor")+")"); });
      });
      progTxt = "Sinava "+cd+" gun kaldi. Ilerleme: %"+Math.round(don/tot*100)+" ("+don+"/"+tot+" tamamlandi).";
      if (p.tytHedef) progTxt += "\nTYT hedef net: "+p.tytHedef;
      if (p.aytHedef) progTxt += "\nAYT hedef net: "+p.aytHedef;
      progTxt += "\n\nGOREVLER:\n"+lines.slice(0,30).join("\n");
    }
    var denTxt = d && d.length > 0
      ? "\n\nSON DENEMELER:\n"+d.slice(0,5).map(function(den) {
          var dt = new Date(den.tarih).toLocaleDateString("tr-TR",{day:"numeric",month:"long"});
          return dt+" "+den.tip+" -> "+den.toplamNet+" net | "+Object.entries(den.detay).map(function(e){ return e[0]+": "+e[1].net+" net"; }).join(", ");
        }).join("\n")
      : "\n\nDeneme kaydi yok.";
    return progTxt + denTxt;
