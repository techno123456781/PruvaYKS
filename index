      var nm = line.match(/^(\d+)\.\s(.+)/);
      if (nm) { elems.push(React.createElement('div', { key: ki++, style: {display:"flex",gap:8,margin:"2px 0"},}, React.createElement('span', { style: {color:"#818cf8",fontWeight:700,minWidth:18,flexShrink:0},}, nm[1], "."), React.createElement('span', null, fmtLine(nm[2])))); return; }
